# Public Supabase configuration (safe for browser bundle)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxx

# Server-only key. NEVER expose this value with NEXT_PUBLIC_.
# Copy the Service Role / Secret key from Supabase project settings.
SUPABASE_SERVICE_ROLE_KEY=your_server_only_service_role_key

# Random secret used to sign rotating attendance QR codes.
# Use at least 32 random characters in production.
QR_SIGNING_SECRET=replace_with_at_least_32_random_characters
